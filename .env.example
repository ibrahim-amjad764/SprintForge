# ============================================================
# SprintForge — Environment Variables
# ============================================================
# Copy this file to `.env.local` (development) or set these in
# your hosting provider's environment settings (production).
# NEVER commit real values — `.env*` is gitignored.
# ============================================================

# ---------- Core ----------

# MongoDB Atlas connection string (required)
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT signing secret — generate a long random string (required)
# Example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Public app URL — used for CORS, emails, Stripe redirects (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.IO endpoint the browser client connects to. Must match the
# port the Socket.IO server listens on (SOCKET_PORT below).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Port the Socket.IO server listens on (server-only, started by
# instrumentation.ts). Default 3001.
SOCKET_PORT=3001

# ---------- AI ----------

# OpenAI API key for AI task breakdown / summaries (optional — AI features disabled without it)
OPENAI_API_KEY=sk-your-openai-key

# ---------- Email ----------

# Resend API key for transactional email (optional)
RESEND_API_KEY=re-your-resend-key

# Sender address for outgoing email
EMAIL_FROM=SprintForge <noreply@yourdomain.com>
# Max send attempts per email (default 3, clamped 1-10). Transient
# failures only: network errors, HTTP 429 and 5xx retry with
# exponential backoff; permanent 4xx fails immediately.
EMAIL_MAX_RETRIES=3

# ---------- File Storage (Cloudinary) ----------

# Cloudinary credentials for attachment/logo uploads (required for file features)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------- Billing (Stripe) ----------

# Stripe secret key — server-side only (optional — billing disabled without it)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook signing secret from the webhook endpoint config (optional)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe publishable key — only needed if Stripe.js is used client-side (currently unused)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your-stripe-publishable-key

# ---------- VCS Provisioning (optional) ----------

# GitHub token for auto-provisioning repositories (optional)
GITHUB_TOKEN=ghp_your-github-token

# GitLab token for auto-provisioning repositories (optional)
GITLAB_TOKEN=glpat-your-gitlab-token

# ---------- Auth (framework reserved) ----------

# Reserved for NextAuth-compatible setups — currently unused by the app
AUTH_SECRET=change-me

# ---------- Runtime ----------

# Set automatically by Next.js — do not set manually
# NODE_ENV=development

# ---------- Observability (optional) ----------

# Sentry DSN — public key, safe to expose client-side. SDK is disabled when unset.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side DSN override (falls back to NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=

# Sentry build-time credentials — only needed for source-map uploads in CI
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
